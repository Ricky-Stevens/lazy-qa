{
  "name": "regress-harness",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": { "node": ">=20.0.0" },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.119",
    "playwright": "1.59.1",
    "zod": "4.3.6",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/bun": "1.3.13",
    "@types/node": "22.19.17",
    "tsx": "^4.16.0",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "scripts": {
    "scan": "tsx --env-file-if-exists=.env bin/regress.ts",
    "review": "tsx --env-file-if-exists=.env bin/regress-review.ts",
    "eval": "tsx --env-file-if-exists=.env bin/regress-eval.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run"
  }
}
