# Anthropic API key — OPTIONAL.
#
# When unset, the Claude Agent SDK falls back to the local `claude` CLI's cached
# subscription auth. That makes interactive dev runs effectively free if you have
# a Pro/Max plan and have run `claude` interactively at least once.
#
# CI must set this; subscription auth needs an interactive OAuth login.
# ANTHROPIC_API_KEY=sk-ant-...

# Auth mode for the LLM. Default: api.
#   api          → use ANTHROPIC_API_KEY (production / CI / users without a Pro/Max plan)
#   subscription → use the local `claude` CLI's cached OAuth token (Pro/Max plan,
#                  developer machines only — Anthropic does not permit redistributing
#                  claude.ai session auth in third-party products). Saves API
#                  credits during local dev. Persona loop, supervisor, and
#                  auth-agent all run end-to-end via the Claude Agent SDK.
#                  A few API-mode features are genuinely SDK-incompatible and
#                  stay deferred for subscription runs (manual sliding-window
#                  compaction with explicit cache-control breakpoints, server-
#                  side MemoryTool20250818, per-turn planner-vs-Haiku model
#                  routing, per-message max_tokens cap) — see loop-sdk.ts
#                  header for the full honest list.
#
# FOOTGUN: if both ANTHROPIC_API_KEY (above) and LLM_AUTH=subscription are set,
# the Claude Agent SDK silently picks up the API key from the environment and
# bills against credits — defeating the entire cost-relief purpose. To use
# your subscription, comment out / unset ANTHROPIC_API_KEY when LLM_AUTH=
# subscription. The harness logs a loud `[llm/factory]` warning at startup
# when this misconfiguration is detected.
# LLM_AUTH=api

# REQUIRED: operator-controlled allowlist of host[:port] entries the YAML's
# target.allowed_hosts may reference. The harness refuses to start without it.
# Set to the staging/dev hosts you have authorised for scanning.
REGRESS_TRUSTED_HOSTS=staging.example.com,localhost:3001

# OPTIONAL: extra non-prod hostnames whose name doesn't match the default
# staging./dev./qa./test./preview./localhost prefixes. Comma-separated, exact
# host[:port] match. Setting this disables the default prefix check entirely;
# you take responsibility for the list.
# REGRESS_NONPROD_HOST_PATTERNS=internal-staging.example.com,my-dev-box

# Per-portal credentials. Env-var names must match ^[A-Z][A-Z0-9_]*$ and must
# NOT start with infrastructure-secret prefixes (ANTHROPIC_, AWS_, GH_, GITHUB_,
# AZURE_, GCP_, etc.) — enforced at config load.
PORTAL_USER=
PORTAL_PASS=

# Optional: log level (info, debug, warn, error)
# LOG_LEVEL=info

# Optional: run Playwright in headless mode (true/false). Default is headed
# (false) so you can watch the agent work.
# PLAYWRIGHT_HEADLESS=false
